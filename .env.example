# ==============================================================================
# VAYORA — Travel & Tourism Management System
# Production Environment Variables Blueprint
# ==============================================================================

# Core Application Runtime
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# Database Configuration (MongoDB Atlas or Local replica set)
MONGODB_URI=mongodb://localhost:27017/vayora

# JSON Web Token Secret
JWT_SECRET=your_super_secret_jwt_key_generate_using_openssl_rand_hex_32

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# Transactional Email Gateway (Resend / SendGrid / SMTP)
RESEND_API_KEY=re_your_live_resend_api_key
SENDGRID_API_KEY=SG.your_sendgrid_key
EMAIL_FROM=VAYORA Concierge <concierge@vayora.com>

# Asset & Cloud Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=vayora-media
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=vayora_production

# Geocoding & Mapping Services (Google Maps / Mapbox)
MAPS_API_KEY=AIzaSy_your_google_maps_platform_key
